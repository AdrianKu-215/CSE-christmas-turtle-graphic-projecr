import turtle

# Create our turtle
t = turtle.Turtle()
t.speed(3)

# 1. Draw the tree trunk (Brown rectangle)
t.penup()
t.goto(-15, -150)
t.pendown()
t.color("saddlebrown")
t.begin_fill()

# Simple loop to draw a rectangle
for i in range(2):
  t.forward(30)
  t.left(90)
  t.forward(60)
  t.left(90)

t.end_fill()


# 2. Draw the tree leaves (Green triangles stacked on top of each other)
t.color("forestgreen")

t.penup()
t.goto(-110, -90)
t.pendown()
t.begin_fill()
t.goto(110, -90)
t.goto(0, -10)
t.goto(-110, -90)
t.end_fill()

t.penup()
t.goto(-80, -20)
t.pendown()
t.begin_fill()
t.goto(80, -20)
t.goto(0, 50)
t.goto(-80, -20)
t.end_fill()

t.penup()
t.goto(-50, 40)
t.pendown()
t.begin_fill()
t.goto(50, 40)
t.goto(0, 110)
t.goto(-50, 40)
t.end_fill()

def draw_gift(x, y):
  t.penup()
  t.goto(x, y)
  t.pendown()
  t.color("crimson")
  t.begin_fill()

  for i in range(2):
    t.forward(40)
    t.left(90)
    t.forward(40)
    t.left(90)

  t.end_fill()


gift_positions = [-70, 30]

for x_pos in gift_positions:
  draw_gift(x_pos, -150)

t.hideturtle()
turtle.done()
